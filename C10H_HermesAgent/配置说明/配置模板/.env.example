# 复制到 E:\hermes\.env
# 密钥只放这里，不要提交到仓库。

HERMES_API_TIMEOUT=1800
OLLAMA_KEEP_ALIVE=24h

# Windows 必填：Hermes 的 file 工具依赖 bash
# 指向 pinned Git 的 usr\bin\bash.exe
HERMES_GIT_BASH_PATH=E:\hermes\tools\git-2.56.1+1-win32-x64\usr\bin\bash.exe

# 换云端模型时才需要（自行填入真实值，勿提交）：
# OPENROUTER_API_KEY=你的_openrouter_key
# ANTHROPIC_API_KEY=你的_anthropic_key
