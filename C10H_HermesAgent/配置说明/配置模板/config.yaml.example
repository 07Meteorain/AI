# C10H 演示机配置模板
# 复制到 E:\hermes\config.yaml 后按需修改。
# 注意：密钥不要写在这里，放同目录 .env。
model:
  default: "gemma4-e2b-64k"          # Ollama 里的模型名
  provider: "custom"                  # 任意 OpenAI 兼容端点
  base_url: "http://127.0.0.1:11434/v1"
  api_key: "no-key"                   # Ollama 不校验，占位即可

terminal:
  backend: local                      # 生产环境建议 docker
  timeout: 300                        # 本地模型 prefill 慢，放宽超时

updates:
  auto_update_check_hours: 0          # 受限网络下关闭被动检查
